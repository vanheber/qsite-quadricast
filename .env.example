# FTP de <dominio-do-cliente> — copie para .env e preencha.
# Depois: npm run deploy:check  ->  npm run deploy:dry  ->  npm run deploy
#
# FTP_PATH é absoluto no servidor (ex.: "/" ou "/public_html").
FTP_HOST=
FTP_USER=
FTP_PASS=
FTP_PORT=21
FTP_PATH=/

# true = FTPS explícito (AUTH TLS). Deixe false se o host só aceita FTP puro.
FTP_TLS=false

# true = espelha apagando no servidor o que não existe mais no build.
FTP_DELETE=true

# URL exibida no fim do deploy (padrão: url do site.json)
PROD_URL=

# Opcional: pasta local a publicar (padrão: public)
# FTP_LOCAL=public
